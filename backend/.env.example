# Script writer: any OpenAI-compatible endpoint. Default = Groq (free key: https://console.groq.com/keys).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_JSON_MODE=true
# Later, gemini-web2api running locally:
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_API_KEY=none
# LLM_MODEL=gemini-3.6-flash
# LLM_JSON_MODE=false
# Optional but recommended: free key at https://pixabay.com/api/docs/ (shown after login).
# Without it, B-roll only comes from remotion-video/public/assets/broll/ (scenes without media get a dark backdrop).
PIXABAY_API_KEY=
# Openverse CC0 photos as an extra fallback. Off by default: results are often unrelated (random portraits).
OPENVERSE_FALLBACK=false
# Optional. Must print a JSON list of posts on stdout; {query} is replaced by the topic.
AGENT_REACH_CMD=
# Voice. gemini = whole script in one Gemini TTS call (free key: https://aistudio.google.com/apikey),
# word timings from Groq Whisper (GROQ_API_KEY, same key as Groq chat). Falls back to edge-tts on any error.
TTS_ENGINE=gemini
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voices: Leda (youthful), Puck / Laomedeia (upbeat), Aoede (breezy), Achird (friendly) ...
GEMINI_TTS_VOICE=Leda
# GEMINI_TTS_STYLE=native Vietnamese Gen Z gossip narrator, playful and teasing, lively, speaking fairly rapidly
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
# Background music: random track from remotion-video/public/assets/bgm/ (optional credits.json {file: credit}).
BGM_VOLUME=0.18
# edge-tts fallback voice, speed / pitch, and silence after each segment.
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+12%
TTS_PITCH=+2Hz
SEGMENT_PADDING_SECONDS=0.25
